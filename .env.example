# Base URL of the VPSI School API, including the version prefix.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Where `npm run gen:api` reads the OpenAPI document from.
VITE_API_DOCS_URL=http://localhost:3000/api/docs-json

# Default UI language: lo | en  (the API supports these two)
VITE_DEFAULT_LOCALE=lo

# School identity shown on the login screen and in the sidebar.
VITE_SCHOOL_NAME_LO=ໂຮງຮຽນ ວີພີເອສໄອ
VITE_SCHOOL_NAME_EN=VPSI School
